# TechFlow Store API — Variables de entorno
# Copiar a .env y ajustar según tu entorno local

# PostgreSQL (requiere psycopg2-binary, ya en pyproject.toml)
# Formato: postgresql+psycopg2://usuario:password@host:puerto/nombre_db
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/techflow

# Alternativa sin Postgres (desarrollo rápido, no requiere servidor):
# DATABASE_URL=sqlite:///./techflow.db

# CORS — URL del frontend para deploy en Render (separar por coma si hay varias)
# Local: http://localhost:5173
# Producción Render: https://proyecto-buenas-practicas.onrender.com
FRONTEND_URL=https://proyecto-buenas-practicas.onrender.com
